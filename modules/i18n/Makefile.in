# Makefile for CLISP module set i18n

srcdir = @srcdir@
CC = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
CLISP = @CLISP@ -norc -q
CLISP_LINKKIT = @CLISP_LINKKIT@

LN = @LN@
LN_S = @LN_S@

MAKE = make

SHELL = /bin/sh

GENERATED = i18n.fas gettext.@OBJEXT@ preload.lisp
DISTRIBFILES = link.sh Makefile $(GENERATED) $(srcdir)/i18n.lisp
distribdir =

# default target: make the module
clisp-module : $(GENERATED)

i18n.fas: $(srcdir)/i18n.lisp
	$(CLISP) -c @BTHS@$(srcdir)/i18n.lisp@BTHE@ -o ./

gettext.@OBJEXT@ : gettext.m.c config.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -I. -I$(CLISP_LINKKIT) \
		-c gettext.m.c -o gettext.@OBJEXT@

gettext.m.c : $(srcdir)/gettext.c
	$(CLISP) -C @BTHS@$(CLISP_LINKKIT)/modprep@BTHE@ @BTHS@$(srcdir)/gettext.c@BTHE@ ./

preload.lisp : $(srcdir)/preload.lisp
	$(LN) $(srcdir)/preload.lisp .

# Make a module distribution into $(distribdir)
clisp-module-distrib : clisp-module force
	$(LN) $(DISTRIBFILES) $(distribdir)

clean : force
	rm -f core *.@OBJEXT@ *.a *.m.c *.fas *.lib

distclean : clean

force :

